# 前端配置
## 应用配置
REACT_APP_APPID=your_app_id         # 飞书应用ID，从飞书开放平台获取
REACT_APP_APP_NAME=腾讯会议         # 应用名称，显示在界面上
REACT_APP_SERVER_URL=feishu-test.example.com  # 服务器域名或IP地址
REACT_APP_SERVER_PROTOCOL=http      # 服务器协议，http或https
REACT_APP_API_PORT=9001             # 后端API端口
REACT_APP_DEBUG_SWITCH=false        # 是否开启调试模式
REACT_APP_MODE=schedule             # 工作台应用打开模式：app(跳转客户端)、upcoming(待参加会议)、schedule(支持创建会议)

## 会议参数配置
REACT_APP_ONLY_USER_JOIN_TYPE=1     # 成员入会限制类型：1(所有成员)、2(仅受邀成员)、3(仅企业内部成员)
REACT_APP_IS_SHOW_WATERMARK_SWITCH=false  # 是否展示水印设置选项
REACT_APP_ALLOW_SCREEN_SHARED_WATERMARK=true  # 是否开启水印
REACT_APP_WATER_MARK_TYPE=0         # 水印样式：0(单排)、1(多排)
REACT_APP_AUDIO_WATERMARK=true      # 是否开启音频水印

## 日志参数配置
REACT_APP_ENABLE_FRONTEND_LOG=false # 是否启用前端日志收集
REACT_APP_LOG_QUEUE_SIZE=100        # 日志队列最大大小
REACT_APP_LOG_FLUSH_INTERVAL=10000  # 日志刷新间隔(毫秒)
REACT_APP_ENABLE_LOG_WORKER=false   # 是否启用Web Worker处理日志
REACT_APP_LOG_WORKER_MAX_RETRY_COUNT=3  # 日志发送最大重试次数
REACT_APP_LOG_WORKER_BATCH_SIZE=50  # 每批发送的最大日志数量
REACT_APP_PROD_ENABLE_ERROR_ONLY=true  # 生产环境是否只记录错误日志
REACT_APP_PROD_ENABLE_STACK_TRACE=false  # 生产环境是否记录调用栈
REACT_APP_PROD_LOG_LEVEL=error      # 生产环境日志级别：debug、info、warn、error

# 后端配置
## 腾讯会议配置
WEMEET_APPID=your_wemeet_appid      # 腾讯会议应用ID
WEMEET_REST_API_SDKID=your_wemeet_rest_api_sdkid  # 腾讯会议REST API SDKID
WEMEET_REST_API_SECRETID=your_wemeet_rest_api_secretid  # 腾讯会议REST API SecretID
WEMEET_REST_API_SECRETKEY=your_wemeet_rest_api_secretkey  # 腾讯会议REST API SecretKey
WEMEET_WEBHOOK_TOKEN=your_wemeet_webhook_token  # 腾讯会议Webhook回调token
WEMEET_WEBHOOK_AESKEY=your_wemeet_webhook_aeskey  # 腾讯会议Webhook回调AES密钥
WEMEET_SSOURL=your_wemeet_sso_url  # 腾讯会议IDaaS/Oneid免登链接前缀地址

## 飞书应用配置
FEISHU_APP_ID=your_feishu_app_id    # 飞书应用ID，从飞书开放平台获取
FEISHU_APP_SECRET=your_feishu_app_secret  # 飞书应用密钥，从飞书开放平台获取
FEISHU_APP_NAME=腾讯会议             # 飞书应用名称
FEISHU_HOME_URL=http://feishu-test.example.com:9000  # 飞书应用首页地址

## 数据库配置 (使用外部数据库服务)
DB_TYPE=mysql                       # 数据库类型：mysql或sqlite
DB_HOST=your_db_host                # 数据库主机地址
DB_PORT=3306                        # 数据库端口
DB_USER=your_db_user                # 数据库用户名
DB_PASSWORD=your_db_password        # 数据库密码
DB_DATABASE=your_db_name            # 数据库名称

## 管理员用户ID
ADMIN_USERID=your_admin_userid      # 管理员用户ID，用于特殊权限操作

## Redis配置
REDIS_HOST=your_redis_host          # Redis主机地址
REDIS_PORT=6379                     # Redis端口
REDIS_PASSWORD=your_redis_password  # Redis密码
REDIS_DB=0                          # Redis数据库编号

## 日志配置
LOG_LEVEL=info                      # 后端日志级别：debug、info、warn、error
