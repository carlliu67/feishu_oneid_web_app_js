# 前端配置
REACT_APP_APPID=your_app_id
REACT_APP_APP_NAME=腾讯会议
REACT_APP_SERVER_URL=feishu-test.example.com
REACT_APP_SERVER_PROTOCOL=http
REACT_APP_API_PORT=9001
REACT_APP_DEBUG_SWITCH=false
REACT_APP_MODE=schedule
## 会议参数配置
REACT_APP_ONLY_USER_JOIN_TYPE=1
REACT_APP_IS_SHOW_WATERMARK_SWITCH=false
REACT_APP_ALLOW_SCREEN_SHARED_WATERMARK=true
REACT_APP_WATER_MARK_TYPE=0
REACT_APP_AUDIO_WATERMARK=true
## 日志参数配置
REACT_APP_ENABLE_FRONTEND_LOG=true
REACT_APP_LOG_QUEUE_SIZE=100
REACT_APP_LOG_FLUSH_INTERVAL=10000
REACT_APP_ENABLE_LOG_WORKER=true
REACT_APP_LOG_WORKER_MAX_RETRY_COUNT=3
REACT_APP_LOG_WORKER_BATCH_SIZE=50
REACT_APP_PROD_ENABLE_ERROR_ONLY=true
REACT_APP_PROD_ENABLE_STACK_TRACE=false
REACT_APP_PROD_LOG_LEVEL=error

# 后端配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_APP_NAME=腾讯会议
FEISHU_HOME_URL=http://feishu-test.example.com:9000

# 腾讯会议配置
WEMEET_APPID=your_wemeet_appid
WEMEET_REST_API_SDKID=your_wemeet_rest_api_sdkid
WEMEET_REST_API_SECRETID=your_wemeet_rest_api_secretid
WEMEET_REST_API_SECRETKEY=your_wemeet_rest_api_secretkey
WEMEET_WEBHOOK_TOKEN=your_wemeet_webhook_token
WEMEET_WEBHOOK_AESKEY=your_wemeet_webhook_aeskey
WEMEET_SSOURL=your_wemeet_sso_url

# 数据库配置 (使用外部数据库服务)
DB_TYPE=mysql
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# 日志配置
LOG_LEVEL=info

# 管理员用户ID
ADMIN_USERID=your_admin_userid

# Redis配置
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
