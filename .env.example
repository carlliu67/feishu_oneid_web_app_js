# 前端配置
## 应用配置
# 飞书应用ID，从飞书开放平台获取
REACT_APP_APPID=
# 应用名称，显示在界面上
REACT_APP_APP_NAME=腾讯会议
# 是否开启调试模式
REACT_APP_DEBUG_SWITCH=false
# 工作台应用打开模式：app(跳转客户端)、upcoming(待参加会议)、schedule(支持创建会议)
REACT_APP_MODE=schedule

## 会议参数配置
# 成员入会限制类型：1(所有成员)、2(仅受邀成员)、3(仅企业内部成员)
REACT_APP_ONLY_USER_JOIN_TYPE=1
# 是否展示水印设置选项
REACT_APP_IS_SHOW_WATERMARK_SWITCH=false
# 是否开启水印
REACT_APP_ALLOW_SCREEN_SHARED_WATERMARK=true
# 水印样式：0(单排)、1(多排)
REACT_APP_WATER_MARK_TYPE=0
# 是否开启音频水印
REACT_APP_AUDIO_WATERMARK=true

## 日志参数配置
# 是否启用前端日志收集
REACT_APP_ENABLE_FRONTEND_LOG=false
# 日志队列最大大小
REACT_APP_LOG_QUEUE_SIZE=100
# 日志刷新间隔(毫秒)
REACT_APP_LOG_FLUSH_INTERVAL=10000
# 是否启用Web Worker处理日志
REACT_APP_ENABLE_LOG_WORKER=false
# 日志发送最大重试次数
REACT_APP_LOG_WORKER_MAX_RETRY_COUNT=3
# 每批发送的最大日志数量
REACT_APP_LOG_WORKER_BATCH_SIZE=50
# 生产环境是否只记录错误日志
REACT_APP_PROD_ENABLE_ERROR_ONLY=true
# 生产环境是否记录调用栈
REACT_APP_PROD_ENABLE_STACK_TRACE=false
# 生产环境日志级别：debug、info、warn、error
REACT_APP_PROD_LOG_LEVEL=error

# 后端配置
## 腾讯会议配置
# 腾讯会议应用ID
WEMEET_APPID=
# 腾讯会议REST API SDKID
WEMEET_REST_API_SDKID=
# 腾讯会议REST API SecretID
WEMEET_REST_API_SECRETID=
# 腾讯会议REST API SecretKey
WEMEET_REST_API_SECRETKEY=
# 腾讯会议Webhook回调token
WEMEET_WEBHOOK_TOKEN=
# 腾讯会议Webhook回调AES密钥
WEMEET_WEBHOOK_AESKEY=
# 腾讯会议IDaaS/Oneid免登链接前缀地址
WEMEET_SSOURL=

## 飞书应用配置
# 飞书应用ID，从飞书开放平台获取
FEISHU_APP_ID=
# 飞书应用密钥
FEISHU_APP_SECRET=
# 飞书应用名称
FEISHU_APP_NAME=腾讯会议
# 飞书应用首页地址 http://feishu-test.example.com:9000
FEISHU_HOME_URL=

## 数据库配置 (使用外部数据库服务)
# 数据库类型：mysql或sqlite
DB_TYPE=sqlite
# 数据库主机地址
DB_HOST=
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=
# 数据库密码
DB_PASSWORD=
# 数据库名称
DB_DATABASE=

## 管理员用户ID
# 管理员用户ID，用于特殊权限操作
ADMIN_USERID=

## Redis配置
# Redis主机地址
REDIS_HOST=
# Redis端口
REDIS_PORT=6379
# Redis密码
REDIS_PASSWORD=
# Redis数据库编号
REDIS_DB=0

## 日志配置
# 后端日志级别：debug、info、warn、error
LOG_LEVEL=info
